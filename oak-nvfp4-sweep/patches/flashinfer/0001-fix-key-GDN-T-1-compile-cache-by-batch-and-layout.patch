+def _tensor_layout_key(
+    torch_t: torch.Tensor,
+) -> tuple[tuple[int, ...], tuple[int, ...]]:
+    """Return the concrete shape/stride signature used by a static descriptor."""
+    return tuple(torch_t.shape), tuple(torch_t.stride())
+
+
+def _batch_descriptor(torch_t: torch.Tensor, *, static: bool):
+    if static:
+        return from_dlpack(torch_t, assumed_align=32, enable_tvm_ffi=True)
+    return _mark_batch_dynamic(torch_t)
+
+
+def _index_descriptor(torch_t: torch.Tensor, *, static: bool):
+    if static:
+        return from_dlpack(torch_t, assumed_align=32, enable_tvm_ffi=True)
+    return _mark_index_dynamic(torch_t)
+
+
