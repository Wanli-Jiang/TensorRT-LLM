diff --git a/tests/gdn/test_decode_pretranspose_bf16_padded_pool.py b/tests/gdn/test_decode_pretranspose_bf16_padded_pool.py
index c64e0e3f..9558e71e 100644
--- a/tests/gdn/test_decode_pretranspose_bf16_padded_pool.py
+++ b/tests/gdn/test_decode_pretranspose_bf16_padded_pool.py
@@ -180,3 +180,111 @@ def test_decode_bf16_pool_strided(B: int, batch_label: str, pool_layout: str) ->
         atol=0.0,
         rtol=0.0,
     )
+
+
+def test_decode_bf16_t1_cache_is_batch_specific() -> None:
+    """T=1 cubins must not be reused across CUDA-graph batch buckets."""
+    _skip_if_not_sm90_or_later()
+
+    from flashinfer.gdn_kernels.gdn_decode_bf16_state import (
+        _compiled_kernels_mtp,
+        _compiled_kernels_wide_vec,
+        gated_delta_rule,
+    )
+
+    device = torch.device("cuda")
+    T, H, HV, K, V = 1, 16, 32, 128, 128
+    pool_size = 64
+    with device:
+        # Keep a padded pool and packed QKV views across the whole descending
+        # ladder, matching serving's non-compact decode layout.
+        pool_storage = torch.zeros(pool_size, HV + 2, V, K, dtype=torch.bfloat16)
+        pool = pool_storage[:, :HV]
+        A_log = torch.randn(HV, dtype=torch.float32) * 0.1
+        dt_bias = torch.randn(HV, dtype=torch.float32) * 0.1
+
+        for batch_size in (24, 16, 4, 2, 1):
+            packed_qkv = torch.randn(
+                batch_size,
+                (2 * H + HV) * K,
+                dtype=torch.bfloat16,
+            )
+            q_end = H * K
+            k_end = 2 * q_end
+            q = packed_qkv[:, :q_end].view(batch_size, T, H, K)
+            k = packed_qkv[:, q_end:k_end].view(batch_size, T, H, K)
+            v = packed_qkv[:, k_end:].view(batch_size, T, HV, V)
+            packed_ba = torch.randn(batch_size, T, 2 * HV, dtype=torch.bfloat16)
+            # Back both batch-scoped tensors with one extra guard row. If a
+            # cubin compiled for a larger B is accidentally reused, the extra
+            # CTA remains inside an allocated tensor instead of faulting, and
+            # these guards make the silent overwrite deterministic.
+            guard_slot = pool_size - 1
+            indices_storage = torch.full(
+                (batch_size + 1,), guard_slot, dtype=torch.int32
+            )
+            indices_storage[:batch_size] = (
+                torch.arange(batch_size, dtype=torch.int32) % guard_slot
+            )
+            indices = indices_storage[:batch_size]
+            output_guard = torch.tensor(42.0, dtype=torch.bfloat16)
+            output_storage = torch.full(
+                (batch_size + 1, T, HV, V),
+                output_guard,
+                dtype=torch.bfloat16,
+            )
+            output = output_storage[:batch_size]
+            guarded_pool_state = pool[guard_slot].clone()
+
+            kwargs = {
+                "A_log": A_log,
+                "a": packed_ba[..., HV:],
+                "dt_bias": dt_bias,
+                "q": q,
+                "k": k,
+                "v": v,
+                "b": packed_ba[..., :HV],
+                "initial_state_source": pool,
+                "initial_state_indices": indices,
+                "output": output,
+            }
+
+            # Compile first, then capture and replay the same call. Serving
+            # follows this pattern for every bucket in its descending graph
+            # ladder; the original failure surfaced on the final B=1 capture.
+            output = gated_delta_rule(**kwargs)
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                output = gated_delta_rule(**kwargs)
+            graph.replay()
+            torch.cuda.synchronize()
+            assert torch.isfinite(output).all()
+            torch.testing.assert_close(
+                output_storage[batch_size:],
+                torch.full_like(output_storage[batch_size:], output_guard),
+                atol=0.0,
+                rtol=0.0,
+            )
+            torch.testing.assert_close(
+                pool[guard_slot], guarded_pool_state, atol=0.0, rtol=0.0
+            )
+
+    torch.cuda.synchronize()
+
+    # B=24/16 use the T=1 wide-vector path; B=4/1 use its ILP4 fallback.
+    # Both caches must contain distinct entries for every T=1 batch bucket.
+    wide_batches = {
+        key[1]
+        for key in _compiled_kernels_wide_vec
+        if key[0] == "v3_mtp_bf16_tiled_dynB"
+        and key[2] == T
+        and key[3] == H
+        and key[4] == HV
+    }
+    fallback_batches = {
+        key[1]
+        for key in _compiled_kernels_mtp
+        if key[0] == "mtp_bf16_dynB" and key[2] == T and key[3] == H and key[4] == HV
+    }
+    assert {24, 16} <= wide_batches
+    assert {4, 2, 1} <= fallback_batches
-- 
