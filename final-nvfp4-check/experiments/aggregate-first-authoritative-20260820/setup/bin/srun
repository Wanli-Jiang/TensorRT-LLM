set -Eeuo pipefail

readonly REAL_SRUN=/cm/local/apps/slurm/25.11/bin/srun
for arg in "$@"; do
    if [[ "${arg}" == --overlap ]]; then
        exec "${REAL_SRUN}" "$@"
    fi
done
exec "${REAL_SRUN}" --overlap "$@"
